#!/usr/bin/env bash
#
# Install all skills from this repo into ~/.claude/skills/ by copying each
# skill directory. Safe to re-run — overwrites changed skills.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_SRC="$SCRIPT_DIR/../skills"

if [[ ! -d "$SKILLS_SRC" ]]; then
    echo "Error: skills directory not found at $SKILLS_SRC" >&2
    exit 1
fi

SKILLS_DST="$HOME/.claude/skills"
mkdir -p "$SKILLS_DST"

installed=()
for skill_dir in "$SKILLS_SRC"/*/; do
    [[ -d "$skill_dir" ]] || continue
    name="$(basename "$skill_dir")"
    target="$SKILLS_DST/$name"

    if [[ -d "$target" ]] && diff -rq "$skill_dir" "$target" >/dev/null 2>&1; then
        echo "  ok  $name"
        installed+=("$name")
        continue
    fi

    rm -rf "$target"
    cp -r "$skill_dir" "$target"
    echo "  added  $name -> $target"
    installed+=("$name")
done

echo ""
echo "Installed ${#installed[@]} skill(s) to $SKILLS_DST"
